[user]
	email = $email
	name = $name
[color]
	diff = auto
	status = auto
	branch = auto
[core]
	autocrlf = input
	excludesfile=$path
	trustctime = false
[alias]
    # Commits
    cap     = "!f() { git add . && git commit -m \"$1\" && git push; }; f"
    undo    = reset --soft HEAD~1
    amend   = commit --amend --no-edit
    amendm  = commit --amend
    # Push
    pf      = push origin HEAD --force
    # Branches
    new     = checkout -b
    branches = branch -v
    wipe    = !git branch | grep -v "\\*" | xargs git branch -D
    gone    = !git fetch -p && git branch -vv | grep ': gone]' | awk '{print $1}' | xargs git branch -D
    # Diff
    ds      = diff --staged
    dm = !git diff $(git merge-base HEAD $(git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'))..HEAD
    # Logs
    gr      = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset:%an' --abbrev-commit --date=relative  
	grall   = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset:%an' --abbrev-commit --date=relative --all 
	gralt   = log --date=iso --pretty=format:\"%h %ad %an %s\" --graph --topo-order --all 
    last    = log -1 HEAD --stat
    today   = log --oneline --since="midnight" --author="$(git config user.name)"
    # Search
    find-merge = "!sh -c 'commit=$0 && branch=${1:-HEAD} && (git rev-list $commit..$branch --ancestry-path | cat -n; git rev-list $commit..$branch --first-parent | cat -n) | sort -k2 | uniq -f1 -d | sort -n | tail -1 | cut -f2'"
    show-merge = "!sh -c 'merge=$(git find-merge $0 $1) && [ -n \"$merge\" ] && git show $merge'"
    # Stash
    ss      = stash save
    sl      = stash list
    sp      = stash pop
    sd      = stash drop
    # Synchronization
    sync    = !git fetch origin && git rebase origin/$(git symbolic-ref --short HEAD)
    # Worktrees
    wtl     = worktree list
    wts     = "!git worktree list --porcelain | sed -n 's/^worktree //p' | while read -r d; do echo \"== $d\"; git -C \"$d\" status -sb; done"
    wtp     = "!f() { git worktree list --porcelain | awk -v b=\"refs/heads/$1\" '/^worktree /{p=substr($0,10); if (b==\"refs/heads/\") {print p; f=1; exit}} $1==\"branch\" && $2==b {print p; f=1; exit} END{exit !f}'; }; f"
    wta     = "!f() { [ -n \"$1\" ] || { echo \"usage: git wta <branch> [base]\"; return 1; }; dir=\"$(git wtp)-$(echo \"$1\" | tr / -)\"; if [ -z \"$2\" ] && { git show-ref --verify --quiet \"refs/heads/$1\" || git show-ref --verify --quiet \"refs/remotes/origin/$1\"; }; then git worktree add \"$dir\" \"$1\"; else git worktree add -b \"$1\" \"$dir\" ${2:+\"$2\"}; fi; }; f"
    wtsend  = "!f() { dir=$(git wtp \"$1\") && [ -n \"$1\" ] || { echo \"no worktree for branch: $1\"; return 1; }; [ -n \"$(git status --porcelain)\" ] || { echo \"nothing to send\"; return 1; }; git stash push -u -m \"wtsend to $1\" && git -C \"$dir\" stash pop; }; f"
    wtc     = "!f() { git wta \"$@\" && git wtsend \"$1\"; }; f"
    wtmv    = "!f() { dir=$(git wtp \"$1\") && [ -n \"$2\" ] || { echo \"usage: git wtmv <branch> <new-path>\"; return 1; }; cd \"${GIT_PREFIX:-.}\" && git worktree move \"$dir\" \"$2\"; }; f"
    wtrm    = "!f() { dir=$(git wtp \"$1\") && [ -n \"$1\" ] || { echo \"no worktree for branch: $1\"; return 1; }; shift; git worktree remove \"$@\" \"$dir\"; }; f"
    wtrmb   = "!f() { b=\"$1\"; git wtrm \"$@\" && git branch -d \"$b\"; }; f"
    wtpr    = worktree prune -v
    # Utilities
    aliases = config --get-regexp alias
[apply]
	whitespace = nowarn
[merge]
	tool = kdiff3
[diff]
	renamelimit = 2048
[rerere]
	enabled =false 
[mergetool]
	trustExitCode = true
